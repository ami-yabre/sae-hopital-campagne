    {
        "id": "321c6500539db08c",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "capteurs",
        "func": "const salles = ['bloc_operatoire', 'salle_soins', 'pharmacie'];\nconst salle = salles[Math.floor(Math.random() * salles.length)];\nconst rnd = (min, max) => Math.round((min + Math.random() * (max - min)) * 10) / 10;\n\nlet temperature = rnd(21, 23);\nlet humidite = rnd(45, 55);\nlet mouvement = 0;\n\n// Anomalie uniquement quand tu cliques sur \"Simuler surchauffe\"\nif (msg.payload === 'surchauffe') {\n  temperature = rnd(31, 38);\n}\n\nlet type = 'aucune';\nlet severite = 'info';\n\nif (temperature > 28) {\n  type = 'temperature_elevee';\n  severite = 'critique';\n} else if (humidite > 75) {\n  type = 'humidite_elevee';\n  severite = 'avertissement';\n}\n\nconst m1 = {\n  payload: [\n    { temperature: temperature, humidite: humidite, mouvement: mouvement },\n    { salle: salle, severite: severite, anomalie: type }\n  ]\n};\n\nlet m2 = null;\nif (type !== 'aucune') {\n  m2 = {\n    payload: {\n      type: type,\n      severite: severite,\n      salle: salle,\n      temperature: temperature,\n      heure: new Date().toISOString()\n    }\n  };\n}\nreturn [m1, m2];",
