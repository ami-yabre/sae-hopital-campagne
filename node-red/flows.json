    {
        "id": "6f1450cab23c661d",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "let badges = global.get('badges');\nif (!badges) {\n  badges = {\n    '63DF0A28': { nom: 'Aminata', role: 'medecin', salles: ['bloc_operatoire', 'salle_soins', 'pharmacie'] }\n  };\n  global.set('badges', badges);\n}\n\nlet b = String(msg.payload.badge_id || '').toUpperCase();\nlet salle = String(msg.payload.salle || 'inconnue');\nlet connu = Object.prototype.hasOwnProperty.call(badges, b);\nlet ok = connu && badges[b].salles.includes(salle);\n\nlet now = Date.now();\nlet refus = flow.get('refus') || [];\nif (!ok) refus.push(now);\nrefus = refus.filter(t => now - t < 60000);\nflow.set('refus', refus);\n\nlet anomalie = 'aucune';\nlet severite = 'info';\nif (refus.length >= 5)  { anomalie = 'brute_force';        severite = 'critique'; }\nelse if (!connu)        { anomalie = 'badge_inconnu';      severite = 'critique'; }\nelse if (!ok)           { anomalie = 'acces_non_autorise'; severite = 'avertissement'; }\n\nlet nom  = connu ? badges[b].nom  : 'inconnu';\nlet role = connu ? badges[b].role : 'inconnu';\n\nlet m1 = { payload: [\n  {\n    etat: ok ? 'PORTE OUVERTE' : 'AUCUN ACCES',\n    statut: ok ? 'autorise' : 'refuse',\n    utilisateur: nom,\n    role: role,\n    nb_refus_60s: refus.length\n  },\n  { salle: salle, badge_id: b, severite: severite, anomalie: anomalie }\n]};\n\nlet m2 = null;\nif (anomalie !== 'aucune') {\n  m2 = { payload: { type: anomalie, severite: severite, salle: salle, badge_id: b,\n                    utilisateur: nom, role: role, heure: new Date().toISOString() } };\n}\n\nlet m3 = { payload: { badge_id: b, salle: salle, ouvrir: ok } };\nreturn [m1, m2, m3];",
