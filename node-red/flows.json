    {
        "id": "8741f7636a8797cd",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Etat porte",
        "func": "const p = msg.payload;\nconst heure = new Date().toLocaleTimeString('fr-FR');\n\nif (p.ouvrir) {\n  node.status({ fill: 'green', shape: 'dot', text: 'PORTE OUVERTE - badge ' + p.badge_id });\n  msg.payload = 'LA PORTE EST OUVERTE | ' + p.salle + ' | badge ' + p.badge_id + ' | ' + heure;\n} else {\n  node.status({ fill: 'red', shape: 'dot', text: 'AUCUN ACCES - badge ' + p.badge_id });\n  msg.payload = 'AUCUN ACCES | ' + p.salle + ' | badge ' + p.badge_id + ' | ' + heure;\n}\n\n// Le statut s'efface au bout de 5 secondes\nsetTimeout(() => node.status({}), 5000);\nreturn msg;",
