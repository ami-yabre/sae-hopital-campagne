    {
        "id": "25c627f5b23d3cc7",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Affichage capteurs",
        "func": "const champs = msg.payload[0];\nconst tags = msg.payload[1];\n\nconst texte = tags.salle + ' | Temperature : ' + champs.temperature + ' °C | Humidite : ' + champs.humidite + ' %';\n\n// Voyant sous le nœud : vert si normal, rouge si anormal\nif (tags.anomalie === 'aucune') {\n    node.status({ fill: 'green', shape: 'dot', text: texte });\n} else {\n    node.status({ fill: 'red', shape: 'ring', text: texte });\n}\n\nmsg.payload = texte;\nreturn msg;",
